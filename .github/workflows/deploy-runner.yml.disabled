# ============================================================
# 备选方案 B：在 GitHub 云端构建，再把 dist 推送到服务器
# ------------------------------------------------------------
# 适用场景：服务器 Node 版本过低/环境复杂，不想在服务器上装 Node
# 优点：Node 版本由 actions/setup-node 指定，不受服务器环境影响；
#       部署只传文件，速度快、结果确定
#
# 启用方法（两步）：
#   1) 把本文件改名为 deploy-runner.yml   ← 注意后缀必须是 .yml 才会生效
#   2) 把原 deploy.yml 改名为 deploy.yml.old（或删除），
#      否则两个 workflow 会同时触发，互相覆盖 dist
#
# 复用现有 Secrets：SERVER_HOST / SERVER_USER / SERVER_SSH_KEY（无需新增）
# ============================================================

name: Auto Deploy (runner build)

on:
  push:
    branches:
      - main

jobs:
  build-and-deploy:
    name: Build on runner & push dist
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      # Node 版本在这里锁死，服务器上装什么版本都不影响构建
      - name: Setup Node
        uses: actions/setup-node@v4
        with:
          node-version: '22'
          cache: 'npm'

      - name: Install dependencies
        run: npm ci

      - name: Build
        run: npm run build

      - name: Show build output
        run: ls -lh dist

      # 先清空服务器旧产物（避免残留废弃文件）
      - name: Clean remote dist
        uses: appleboy/ssh-action@v1.0.3
        with:
          host: ${{ secrets.SERVER_HOST }}
          username: ${{ secrets.SERVER_USER }}
          key: ${{ secrets.SERVER_SSH_KEY }}
          script: |
            set -e
            mkdir -p /root/zero-to-tech/dist
            rm -rf /root/zero-to-tech/dist/*
            echo "remote dist cleaned"

      # 把本地构建好的 dist 上传到服务器
      - name: Upload dist to server
        uses: appleboy/scp-action@v0.1.7
        with:
          host: ${{ secrets.SERVER_HOST }}
          username: ${{ secrets.SERVER_USER }}
          key: ${{ secrets.SERVER_SSH_KEY }}
          source: "dist/*"
          target: "/root/zero-to-tech/dist"
          strip_components: 1
          overwrite: true

      - name: Verify remote
        uses: appleboy/ssh-action@v1.0.3
        with:
          host: ${{ secrets.SERVER_HOST }}
          username: ${{ secrets.SERVER_USER }}
          key: ${{ secrets.SERVER_SSH_KEY }}
          script: |
            ls -lh /root/zero-to-tech/dist
